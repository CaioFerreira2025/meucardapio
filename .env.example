# Banco de dados (Fase 0: SQLite local, zero-config).
# Para produção, troque para uma connection string Postgres, ex.:
# DATABASE_URL="postgresql://user:password@host:5432/dbname"
DATABASE_URL="file:./dev.db"

# Auth.js (Fase 1) — chave usada para assinar sessões/JWT.
# Gere uma nova com: openssl rand -base64 32
AUTH_SECRET=""

# URL base da aplicação (usada pelo Auth.js em callbacks/redirects).
NEXTAUTH_URL="http://localhost:3000"

# Necessário ao rodar atrás de proxy/porta diferente de NEXTAUTH_URL
# (Docker, plataformas de hospedagem, etc). Em produção, prefira configurar
# NEXTAUTH_URL corretamente em vez de confiar em qualquer host.
AUTH_TRUST_HOST=true

# URL pública usada nos redirects do Stripe Checkout/Portal.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe (Fase 2) — pegue em https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# IDs dos preços (Price ID, não Product ID) criados no Stripe Dashboard,
# um por plano definido em src/config/plans.ts.
STRIPE_PRICE_ID_STARTER=""
STRIPE_PRICE_ID_PRO=""
