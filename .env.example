# Banco de dados (Fase 0: SQLite local, zero-config).
# Para produção, troque para uma connection string Postgres, ex.:
# DATABASE_URL="postgresql://user:password@host:5432/dbname"
DATABASE_URL="file:./dev.db"

# Auth.js (Fase 1) — chave usada para assinar sessões/JWT.
# Gere uma nova com: openssl rand -base64 32
AUTH_SECRET=""

# URL base da aplicação (usada pelo Auth.js em callbacks/redirects).
NEXTAUTH_URL="http://localhost:3000"

# Necessário ao rodar atrás de proxy/porta diferente de NEXTAUTH_URL
# (Docker, plataformas de hospedagem, etc). Em produção, prefira configurar
# NEXTAUTH_URL corretamente em vez de confiar em qualquer host.
AUTH_TRUST_HOST=true

# URL pública usada nos redirects de checkout.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cakto (Fase 2) — gateway de pagamentos atual (Pix, cartão de crédito e
# débito), substitui a integração antiga com Stripe abaixo.
#
# Client ID/Secret: painel da Cakto → Integrações → API. Usados só para
# chamadas autenticadas (hoje, cancelar assinatura — ver src/lib/cakto.ts).
CAKTO_CLIENT_ID=""
CAKTO_CLIENT_SECRET=""

# ID de cada oferta/produto cadastrado no painel da Cakto — aparece na URL
# do checkout hospedado (pay.cakto.com.br/<id>). Um por plano definido em
# src/config/plans.ts.
CAKTO_OFFER_ID_STARTER=""
CAKTO_OFFER_ID_PRO=""

# Secret do webhook (painel da Cakto → Webhooks → seu webhook → "fields.secret").
# É um UUID GERADO AUTOMATICAMENTE pela Cakto ao criar o webhook — não dá
# pra escolher o valor, só copiar de lá. Se você cadastrou um único webhook
# cobrindo Starter e Pro, preencha só CAKTO_WEBHOOK_SECRET. Se cadastrou um
# webhook por plano (cada um com seu próprio secret), preencha os dois de
# baixo em vez disso — os três são aceitos ao mesmo tempo (ver
# isValidCaktoWebhookSecret em src/lib/cakto.ts). Todos apontam pra mesma
# URL: /api/webhooks/cakto.
CAKTO_WEBHOOK_SECRET=""
CAKTO_WEBHOOK_SECRET_STARTER=""
CAKTO_WEBHOOK_SECRET_PRO=""

# --- Legado: Stripe (integração anterior, substituída pela Cakto acima) ---
# Mantido só porque o schema do Prisma ainda guarda dados de assinaturas
# antigas criadas com o Stripe (ver model Subscription). Não configure isso
# num projeto novo.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_STARTER=""
STRIPE_PRICE_ID_PRO=""
