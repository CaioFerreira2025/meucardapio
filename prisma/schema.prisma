// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Fase 0: SQLite para dev local (zero-config). Para produção, troque
// `provider` para "postgresql" e aponte DATABASE_URL para o banco real
// (Neon, Supabase, Railway, etc.) — o schema abaixo já é compatível.

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  // "native" gera o engine da plataforma que roda `prisma generate` (Linux,
  // neste sandbox); "windows" garante que o Prisma Client continue
  // funcionando na máquina Windows do dono do projeto sem reinstalar nada.
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Autenticação (compatível com Auth.js / NextAuth Prisma Adapter)
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  password         String? // hash bcrypt, usado no login por credenciais
  stripeCustomerId String?   @unique

  // Fim do período de teste gratuito (15 dias, ver TRIAL_DAYS em
  // src/lib/access.ts). Preenchido no cadastro (src/app/api/register/route.ts).
  // Opcional de propósito: contas criadas ANTES desta funcionalidade existir
  // têm `null` aqui, e `null` é tratado como "sem trial registrado" — nunca
  // como "trial vencido" —, então nenhuma conta antiga é bloqueada de
  // surpresa por causa de um campo que não existia quando ela foi criada.
  trialEndsAt      DateTime?

  // CPF/CNPJ e WhatsApp, só dígitos (ver src/lib/identity.ts). Coletados no
  // cadastro. Além de servirem de chave do teste único (via TrialClaim
  // abaixo), são o que permite casar um pagamento da Cakto com a conta certa
  // quando o cliente paga usando um e-mail diferente do cadastro — ver
  // src/app/api/webhooks/cakto/route.ts. Opcionais porque contas antigas não
  // os têm; `@unique` para não existirem duas contas com o mesmo documento.
  document         String?   @unique
  phone            String?   @unique

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  subscription Subscription?
  restaurant   Restaurant?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Registro permanente de quem JÁ usou o teste gratuito de 15 dias.
//
// Existe separado de `User` por um motivo específico: se a marcação de
// "já usou o trial" morasse só no usuário, bastaria excluir a conta (ou
// criar outra com e-mail novo) para ganhar mais 15 dias — que é exatamente
// o abuso que isto previne. Esta tabela NÃO tem relação com cascade: o
// registro sobrevive à exclusão do usuário de propósito.
//
// `document` e `phone` são chaves únicas independentes: basta um dos dois
// bater para o novo cadastro não receber teste. Guardados só em dígitos
// (ver src/lib/identity.ts), senão a mesma pessoa burlaria variando
// pontuação ou o prefixo +55.
model TrialClaim {
  id String @id @default(cuid())

  document String @unique
  phone    String @unique

  // Conta que originou o registro. Fica apenas como rastro para suporte
  // ("qual conta usou este CPF?"); intencionalmente SEM relação com `User`,
  // para que apagar o usuário não apague nem invalide este registro.
  userId    String?
  userEmail String?

  claimedAt DateTime @default(now())

  @@map("trial_claims")
}

// Módulos sob demanda habilitados para um restaurante.
//
// A linha existir = módulo ligado para aquele cliente. Não existir = base.
//
// `moduleKey` é String LIVRE, e não um enum do Prisma, de propósito: criar
// um módulo novo precisa ser só adicionar uma entrada no registro em
// src/modules/registry.ts e ligar para o cliente. Se fosse enum, todo
// módulo novo exigiria uma migração de banco — e migração é exatamente o
// tipo de mudança global que este desenho quer evitar, já que ela toca o
// schema de TODOS os clientes para atender um só.
//
// Os campos de auditoria existem porque isto reflete um acordo comercial:
// quando alguém perguntar "por que o Restaurante X tem esse recurso?", a
// resposta está na própria linha, não na memória de quem ligou.
model RestaurantModule {
  id           String @id @default(cuid())
  restaurantId String

  /** Chave do módulo no registro (ver src/modules/registry.ts). */
  moduleKey String

  enabledAt      DateTime @default(now())
  /** E-mail do admin que ligou — rastro de quem liberou o quê. */
  enabledByEmail String?
  /** Espaço livre: nº do contrato, combinado comercial, prazo de teste. */
  notes          String?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Um módulo só pode estar ligado uma vez por restaurante.
  @@unique([restaurantId, moduleKey])
  // Para responder rápido "quais clientes têm o módulo X?".
  @@index([moduleKey])
  @@map("restaurant_modules")
}

// ---------------------------------------------------------------------------
// Tabelas dos módulos sob demanda
// ---------------------------------------------------------------------------
//
// Cada tabela abaixo pertence a UM módulo e só é lida/escrita pelo código
// daquele módulo. Restaurante sem o módulo ligado nunca tem linha aqui — e,
// se o módulo for desligado, os dados permanecem (desligar tira o acesso à
// tela, não apaga o trabalho do lojista).

/// Módulo "entregas": taxa de entrega fixa por bairro.
model DeliveryZone {
  id           String @id @default(cuid())
  restaurantId String

  /// Nome do bairro como o cliente vê no checkout.
  neighborhood String
  /// Taxa de entrega em centavos (0 = entrega grátis para o bairro).
  feeCents     Int    @default(0)
  position     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Um bairro não pode ser cadastrado duas vezes no mesmo restaurante.
  @@unique([restaurantId, neighborhood])
  @@map("delivery_zones")
}

/// Módulo "horarios": agenda de funcionamento por dia da semana.
model BusinessHour {
  id           String @id @default(cuid())
  restaurantId String

  /// 0 = domingo ... 6 = sábado (mesma convenção de Date.getDay()).
  weekday  Int
  /// Minutos desde a meia-noite. 480 = 08:00, 1320 = 22:00.
  opensAt  Int     @default(480)
  closesAt Int     @default(1320)
  /// Dia em que a loja não abre (folga).
  isClosed Boolean @default(false)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, weekday])
  @@map("business_hours")
}

/// Módulo "cupons": códigos promocionais.
model Coupon {
  id           String @id @default(cuid())
  restaurantId String

  /// Sempre em MAIÚSCULAS (normalizado na gravação) — o cliente digita
  /// como quiser e a comparação continua funcionando.
  code String

  /// "percent" (desconto em %) ou "fixed" (valor fixo em centavos).
  discountType  String @default("percent")
  /// Percentual (1-100) ou centavos, conforme `discountType`.
  discountValue Int

  /// Valor mínimo do pedido para o cupom valer (0 = sem mínimo).
  minOrderCents Int @default(0)
  /// Limite de usos (null = ilimitado).
  maxUses       Int?
  usedCount     Int @default(0)

  expiresAt DateTime?
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, code])
  @@map("coupons")
}

// ---------------------------------------------------------------------------
// Cobrança (Fase 2 — Cakto)
// ---------------------------------------------------------------------------

model Subscription {
  id     String @id @default(cuid())
  userId String @unique

  // Campos antigos da integração com o Stripe (substituída pela Cakto).
  // Ficam como `String?` opcionais em vez de removidos: assinaturas antigas
  // criadas enquanto o Stripe ainda estava ativo continuam com esses dados
  // intactos — nada é apagado numa migração destrutiva. Assinaturas novas
  // não preenchem mais esses dois campos.
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  // Campos da integração com a Cakto (gateway atual — Pix, cartão de
  // crédito e débito). `caktoOfferId` identifica qual plano (Starter/Pro)
  // foi assinado, equivalente ao antigo `stripePriceId` — ver
  // src/config/plans.ts.
  caktoSubscriptionId String? @unique
  caktoOfferId        String?

  // Espelha o status recebido nos eventos de webhook (active, past_due,
  // canceled, paused — ver src/app/api/webhooks/cakto/route.ts). Mesmo
  // vocabulário que já era usado com o Stripe, então a tela de Cobrança e o
  // Painel Administrativo não precisaram mudar.
  status            String
  currentPeriodEnd  DateTime
  cancelAtPeriodEnd Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// CardápioPontoCom — cardápio digital e pedidos (Fase 3)
// ---------------------------------------------------------------------------

// Cada usuário dono de restaurante tem 1 Restaurant (MVP: sem multi-loja
// por conta ainda). `slug` é a URL pública do cardápio: /r/[slug].
model Restaurant {
  id          String   @id @default(cuid())
  ownerId     String   @unique
  name        String
  slug        String   @unique
  description String?
  phone       String?
  address     String?
  isOpen      Boolean  @default(true)
  // Logo do lojista — mesmo formato de armazenamento das fotos de produto
  // (data URL base64 direto no banco, ver src/lib/uploads.ts):
  // `null` = nenhuma logo enviada ainda, cai no ícone genérico da marca.
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  categories   Category[]
  orders       Order[]
  cashSessions CashSession[]
  reviews      Review[]
  modules      RestaurantModule[]
  deliveryZones DeliveryZone[]
  businessHours BusinessHour[]
  coupons       Coupon[]

  @@map("restaurants")
}

model Category {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  description String?
  // Preço em centavos (evita ponto flutuante em dinheiro).
  priceCents  Int
  // Custo em centavos (opcional — usado para calcular a margem no painel).
  // `null` = custo não informado ainda; não exibimos margem nesse caso.
  costCents   Int?
  imageUrl    String?
  isAvailable Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  // "Venda mais" — produtos complementares sugeridos junto com este (ex.:
  // Picanha -> Batata, Farofa, Refrigerante). Auto-relação m:n implícita:
  // `complements` é o que ESTE produto sugere; `complementFor` é o
  // inverso (produtos que sugerem este). Mesma tabela de junção nos dois
  // lados, então nenhum sistema paralelo é criado.
  complements   Product[] @relation("ProductComplements")
  complementFor Product[] @relation("ProductComplements")

  @@map("products")
}

model Order {
  id            String   @id @default(cuid())
  restaurantId  String
  customerName  String
  customerPhone String
  tableNumber   String?
  notes         String?
  // pending -> preparing -> ready -> completed (ou cancelled a qualquer momento)
  status        String   @default("pending")
  totalCents    Int

  // ----- Campos dos módulos sob demanda (ver src/modules/registry.ts) -----
  // Todos com valor padrão ou nulos: um restaurante SEM os módulos ligados
  // simplesmente nunca os preenche, e nenhum pedido antigo precisou mudar.
  //
  // `totalCents` continua sendo o VALOR FINAL cobrado (itens - desconto +
  // entrega). Os campos abaixo existem para a conta ser auditável depois —
  // sem eles, um pedido com cupom viraria só um total menor sem explicação.
  deliveryFeeCents Int     @default(0)
  discountCents    Int     @default(0)
  couponCode       String?
  neighborhood     String?
  // "cash" | "pix" | "card" — informado pela equipe ao fechar a mesa/pedido
  // (não existe no checkout do cliente). `null` = ainda não informado; não
  // entra na quebra por forma de pagamento do Caixa até ser preenchido.
  paymentMethod String?
  // Cliente (ou garçom) sinalizou que quer fechar a conta dessa mesa. Fica
  // `true` até a equipe fechar a mesa (ver `closeTable`), quando os pedidos
  // da mesa viram "completed" e o valor some do alerta.
  billRequested Boolean  @default(false)
  // Pedido "Entregue" que o lojista arquivou pra sumir do quadro kanban
  // ativo (Central de pedidos), sem apagar do banco. Só é lido/gravado pela
  // nova action `setOrderArchived` — não interfere no fluxo de status
  // (pending -> preparing -> ready -> completed -> cancelled) nem em nenhum
  // outro módulo.
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      OrderItem[]

  @@map("orders")
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  // snapshot do produto no momento do pedido (preço pode mudar depois)
  productName    String
  unitPriceCents Int
  quantity       Int
  notes          String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// Turno de caixa: abre com um valor inicial na gaveta (troco), acompanha o
// faturamento em dinheiro do turno, e fecha com a contagem física informada
// pelo operador — o saldo esperado (inicial + vendas em dinheiro) é
// calculado automaticamente e comparado com o que foi contado.
model CashSession {
  id            String    @id @default(cuid())
  restaurantId  String
  openedAt      DateTime  @default(now())
  openingCents  Int       @default(0)
  closedAt      DateTime?
  // Contagem física informada pelo operador ao fechar (`null` = turno ainda
  // aberto).
  closingCents  Int?
  // Saldo esperado calculado no momento do fechamento (inicial + vendas em
  // dinheiro do período do turno) — guardado para auditoria, já que pedidos
  // futuros não devem mudar o resultado de um turno já fechado.
  expectedCents Int?
  // "open" | "closed"
  status        String    @default("open")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("cash_sessions")
}

// Avaliação da experiência, enviada pelo cliente no cardápio público
// (menu inferior -> "Mais" -> "Avaliar experiência"). Sem cadastro/login do
// cliente, então não há um "autor" identificável além do que ele mesmo
// digita — mantemos simples de propósito: 1 nota (1 a 5) e um comentário
// opcional, sem vínculo obrigatório com um pedido específico (o cliente
// pode avaliar a experiência geral, não só um pedido).
model Review {
  id           String   @id @default(cuid())
  restaurantId String
  // 1 a 5 — validado na Server Action (submitReview) antes de chegar aqui;
  // sem `@@check` porque o driver do Postgres usado no Prisma Client aqui
  // não depende disso para a validação de negócio.
  rating       Int
  comment      String?
  // Nome/telefone de quem avaliou — obrigatórios (validados em
  // reviewSchema/review-modal.tsx): o painel (Avaliações) depende do
  // telefone pra mostrar o atalho "Responder no WhatsApp" com link wa.me
  // pré-preenchido, então passaram a ser exigidos no envio da avaliação.
  name         String
  phone        String
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("reviews")
}