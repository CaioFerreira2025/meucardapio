// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Fase 0: SQLite para dev local (zero-config). Para produção, troque
// `provider` para "postgresql" e aponte DATABASE_URL para o banco real
// (Neon, Supabase, Railway, etc.) — o schema abaixo já é compatível.

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  // "native" gera o engine da plataforma que roda `prisma generate` (Linux,
  // neste sandbox); "windows" garante que o Prisma Client continue
  // funcionando na máquina Windows do dono do projeto sem reinstalar nada.
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Autenticação (compatível com Auth.js / NextAuth Prisma Adapter)
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  password         String? // hash bcrypt, usado no login por credenciais
  stripeCustomerId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  subscription Subscription?
  restaurant   Restaurant?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Cobrança (Fase 2 — Cakto)
// ---------------------------------------------------------------------------

model Subscription {
  id     String @id @default(cuid())
  userId String @unique

  // Campos antigos da integração com o Stripe (substituída pela Cakto).
  // Ficam como `String?` opcionais em vez de removidos: assinaturas antigas
  // criadas enquanto o Stripe ainda estava ativo continuam com esses dados
  // intactos — nada é apagado numa migração destrutiva. Assinaturas novas
  // não preenchem mais esses dois campos.
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  // Campos da integração com a Cakto (gateway atual — Pix, cartão de
  // crédito e débito). `caktoOfferId` identifica qual plano (Starter/Pro)
  // foi assinado, equivalente ao antigo `stripePriceId` — ver
  // src/config/plans.ts.
  caktoSubscriptionId String? @unique
  caktoOfferId        String?

  // Espelha o status recebido nos eventos de webhook (active, past_due,
  // canceled, paused — ver src/app/api/webhooks/cakto/route.ts). Mesmo
  // vocabulário que já era usado com o Stripe, então a tela de Cobrança e o
  // Painel Administrativo não precisaram mudar.
  status            String
  currentPeriodEnd  DateTime
  cancelAtPeriodEnd Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// CardápioPontoCom — cardápio digital e pedidos (Fase 3)
// ---------------------------------------------------------------------------

// Cada usuário dono de restaurante tem 1 Restaurant (MVP: sem multi-loja
// por conta ainda). `slug` é a URL pública do cardápio: /r/[slug].
model Restaurant {
  id          String   @id @default(cuid())
  ownerId     String   @unique
  name        String
  slug        String   @unique
  description String?
  phone       String?
  address     String?
  isOpen      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  categories   Category[]
  orders       Order[]
  cashSessions CashSession[]

  @@map("restaurants")
}

model Category {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  description String?
  // Preço em centavos (evita ponto flutuante em dinheiro).
  priceCents  Int
  // Custo em centavos (opcional — usado para calcular a margem no painel).
  // `null` = custo não informado ainda; não exibimos margem nesse caso.
  costCents   Int?
  imageUrl    String?
  isAvailable Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  // "Venda mais" — produtos complementares sugeridos junto com este (ex.:
  // Picanha -> Batata, Farofa, Refrigerante). Auto-relação m:n implícita:
  // `complements` é o que ESTE produto sugere; `complementFor` é o
  // inverso (produtos que sugerem este). Mesma tabela de junção nos dois
  // lados, então nenhum sistema paralelo é criado.
  complements   Product[] @relation("ProductComplements")
  complementFor Product[] @relation("ProductComplements")

  @@map("products")
}

model Order {
  id            String   @id @default(cuid())
  restaurantId  String
  customerName  String
  customerPhone String
  tableNumber   String?
  notes         String?
  // pending -> preparing -> ready -> completed (ou cancelled a qualquer momento)
  status        String   @default("pending")
  totalCents    Int
  // "cash" | "pix" | "card" — informado pela equipe ao fechar a mesa/pedido
  // (não existe no checkout do cliente). `null` = ainda não informado; não
  // entra na quebra por forma de pagamento do Caixa até ser preenchido.
  paymentMethod String?
  // Cliente (ou garçom) sinalizou que quer fechar a conta dessa mesa. Fica
  // `true` até a equipe fechar a mesa (ver `closeTable`), quando os pedidos
  // da mesa viram "completed" e o valor some do alerta.
  billRequested Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      OrderItem[]

  @@map("orders")
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  // snapshot do produto no momento do pedido (preço pode mudar depois)
  productName    String
  unitPriceCents Int
  quantity       Int
  notes          String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// Turno de caixa: abre com um valor inicial na gaveta (troco), acompanha o
// faturamento em dinheiro do turno, e fecha com a contagem física informada
// pelo operador — o saldo esperado (inicial + vendas em dinheiro) é
// calculado automaticamente e comparado com o que foi contado.
model CashSession {
  id            String    @id @default(cuid())
  restaurantId  String
  openedAt      DateTime  @default(now())
  openingCents  Int       @default(0)
  closedAt      DateTime?
  // Contagem física informada pelo operador ao fechar (`null` = turno ainda
  // aberto).
  closingCents  Int?
  // Saldo esperado calculado no momento do fechamento (inicial + vendas em
  // dinheiro do período do turno) — guardado para auditoria, já que pedidos
  // futuros não devem mudar o resultado de um turno já fechado.
  expectedCents Int?
  // "open" | "closed"
  status        String    @default("open")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("cash_sessions")
}